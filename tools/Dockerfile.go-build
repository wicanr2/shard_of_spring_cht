# Ebitengine 的 Linux 建置環境。
#
# 為什麼需要這顆:Ebitengine 走 cgo,編譯期要 X11 與 OpenGL 的標頭檔,
# 純 golang image 沒有。執行期的 GL/X11 由使用者桌面提供,不在這裡。
#
# ⚠ **音訊(docs/spec/13)另外要 ALSA 的標頭檔** —— `ebiten/v2/audio` 底下的
# `oto/v3` 走 cgo 連 ALSA。少了它 `go vet` 會停在
# `Package 'alsa', required by 'virtual:world', not found`,
# 而那個訊息**看起來像 pkg-config 壞了**,不像少一個 dev 套件。
#
# ⚠ **測試期還要 Xvfb**。`package main` 匯入 ebiten 時,
# `internal/ui` 的 `init()` 會呼叫 `glfw.Init()`,**沒有 DISPLAY 就 panic**:
#   glfw: X11: The DISPLAY environment variable is missing
#   panic: glfw: The GLFW library is not initialized
# 這發生在**任何**測試跑起來之前(是 package init,不是測試內容),
# 所以連一個空的 `func TestX(t *testing.T){}` 都跑不了。
# `tools/go.sh test` 因此把 `go test` 包在 `xvfb-run` 裡。
#
# ⚠ 沒修之前這個坑會**假裝自己不存在**:package main 一旦有過一次成功的
# 測試結果進 build cache,之後 `go test` 會回 `ok (cached)` ——
# **綠燈是快取在說話,不是測試真的跑過**。用 `-count=1` 才看得到真相。
#
# ⚠ **`oggenc`(vorbis-tools)** 給 `tools/music.sh` 用:
# 場景配樂是自己寫的譜,渲染成 PCM 之後要壓成 OGG 進版控(docs/spec/13 §7)。
# Go 沒有成熟的純 Go Vorbis **編碼器**(`ebiten/audio/vorbis` 只解不編)。
#
# ⚠ **AppImage 的兩件工具**給 `tools/release.sh` 的 Linux 目標用:
#   `appimagetool` 本身,以及 **runtime 檔**。
#   帶 `--runtime-file` 是為了**不在打包時上網抓 runtime**,
#   也避開容器裡沒有 FUSE 的問題 —— appimagetool 預設會去掛載自己。
#
# 建置:tools/go.sh 會在 image 不存在時自動建
#   docker build -f tools/Dockerfile.go-build -t shard-go-build:5 tools/
#
# ⚠ 這是本專案自己建的 image,清理時只能動它;
#   禁止對共用資源做 prune / rmi(CLAUDE.md §8)。
FROM golang:1.24-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1-mesa-dev \
        libx11-dev \
        libxrandr-dev \
        libxcursor-dev \
        libxinerama-dev \
        libxi-dev \
        libxxf86vm-dev \
        libasound2-dev \
        pkg-config \
        xvfb \
        xauth \
        vorbis-tools \
        squashfs-tools \
        desktop-file-utils \
        file \
        zsync \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# AppImage 工具。**只在建 image 時上網**,打包本身仍然 `--network none`。
ARG APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage
ARG APPIMAGE_RUNTIME_URL=https://github.com/AppImage/type2-runtime/releases/download/continuous/runtime-x86_64
RUN curl -fsSL "$APPIMAGETOOL_URL" -o /tmp/appimagetool.AppImage \
    && chmod +x /tmp/appimagetool.AppImage \
    # AppImage 要 FUSE 才掛得起來,容器裡沒有 —— 先就地解開再用解開的那份。
    && (cd /tmp && ./appimagetool.AppImage --appimage-extract >/dev/null) \
    && mv /tmp/squashfs-root /opt/appimagetool \
    && ln -s /opt/appimagetool/AppRun /usr/local/bin/appimagetool \
    && curl -fsSL "$APPIMAGE_RUNTIME_URL" -o /opt/appimage-runtime-x86_64 \
    && chmod +x /opt/appimage-runtime-x86_64 \
    && rm -f /tmp/appimagetool.AppImage
